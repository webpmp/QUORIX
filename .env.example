# Copy this file to .env when running locally (cp .env.example .env)
# Note: Market, News, and FRED keys can also be configured at runtime in the SETT screen.
# Yahoo Finance quotes/charts/news and Polymarket feeds work without API keys.

# GEMINI_API_KEY: Required for AI analyst / grounding features (BWRITE, DES, ANR).
# Request a key: https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Base URL where this app is hosted (optional locally, e.g. http://localhost:3000).
APP_URL="MY_APP_URL"

# ALPHA_VANTAGE_API_KEY: Third-party API key for fallback stock quotes & intraday data.
# Request a key: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# NYT_API_KEY: New York Times Business Top Stories API key (Top Stories API).
# Request a key: https://developer.nytimes.com/get-started
NYT_API_KEY=

# NEWS_API_KEY: NewsAPI.org key for global corporate & business headlines.
# Request a key: https://newsapi.org/register
NEWS_API_KEY=

# NEWSDATA_API_KEY: Newsdata.io key for real-time business & financial news.
# Request a key: https://newsdata.io/register
NEWSDATA_API_KEY=

# FRED_API_KEY: Federal Reserve Economic Data (St. Louis Fed) key for ECO macro indicators, calendar & FX rates.
# Request a key: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# 3SPREAD_API_KEY (or THREESPREAD_API_KEY): 3spread API key for INSTITUTIONAL ACTIVITY (Form 13F holdings, accumulation & profiles).
# Request a free Community tier key: https://www.3spread.com/auth/signup
3SPREAD_API_KEY=
THREESPREAD_API_KEY=

